# Copy to .env and change every value. .env is ignored by git.
# Generate a value with: openssl rand -hex 24
POSTGRES_PASSWORD=change-me
RABBITMQ_PASSWORD=change-me
# Alert senders must send "Authorization: Bearer <INGEST_TOKEN>"
INGEST_TOKEN=change-me
# Signs the acknowledge and resolve links in page emails
ACTION_LINK_SECRET=change-me

# Keycloak: admin console at http://localhost:8180 (user "admin")
KEYCLOAK_ADMIN_PASSWORD=change-me
# Client secrets of the realm in deploy/keycloak (the gateway, notify, and scripts such as seed-demo.sh)
PAGEREWIND_WEB_CLIENT_SECRET=change-me
NOTIFY_CLIENT_SECRET=change-me
AUTOMATION_CLIENT_SECRET=change-me
# Password of the demo logins alice, bob (responders) and vera (viewer); at least 12 characters
DEMO_PASSWORD=change-me

# Optional: Telegram pages (token from @BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Image version to run ("main" is the latest build of the main branch)
PAGEREWIND_VERSION=0.2.0
