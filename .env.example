# Copy to .env and change every value. .env is ignored by git.
# Generate a value with: openssl rand -hex 24
POSTGRES_PASSWORD=change-me
RABBITMQ_PASSWORD=change-me
# Alert senders must send "Authorization: Bearer <INGEST_TOKEN>"
INGEST_TOKEN=change-me
# Signs the acknowledge and resolve links in page emails
ACTION_LINK_SECRET=change-me

# Optional: Telegram pages (token from @BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Image version to run
PAGEREWIND_VERSION=0.1.0
